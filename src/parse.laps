%{

use lalr1;
use lexan;

#[allow(dead_code)]
#[derive(Debug, Default, PartialEq, Eq)]
pub enum CommandAction {
    SetEnvVar(String, String),
    UnsetEnvVar(String),
    RunProgram(String, Vec<String>, Option<String>, Option<String>, Option<String>),
    #[default]
    Default,
}

#[derive(Debug, Default)]
pub struct Command {
    pub string: String,
    pub action: CommandAction
}

#[cfg(test)]
pub mod parser_tests;

impl lalr1::ReportError<AATerminal> for Command {}

#[allow(dead_code)]
#[derive(Debug, Default, Clone)]
pub enum AttributeData {
    Token(lexan::Token<AATerminal>),
    Error(lalr1::Error<AATerminal>),
    String(String),
    Id(String),
    #[default]
    Default
}

impl AttributeData {
    fn string(&self) -> String {
        match self {
            Self::String(string) => string.clone(),
            _ => panic!("Invalid AttributeData variant")
        }
    }

    fn id(&self) -> String {
        match self {
            Self::Id(string) => string.clone(),
            _ => panic!("Invalid AttributeData variant")
        }
    }
}

impl From<lexan::Token<AATerminal>> for AttributeData {
    fn from(input: lexan::Token<AATerminal>) -> Self {
        match input.tag() {
            AATerminal::STRING => AttributeData::String(input.lexeme().to_string()),
            AATerminal::ID => AttributeData::Id(input.lexeme().to_string()),
            _ => AttributeData::Token(input.clone())
        }
    }
}

impl From<lalr1::Error<AATerminal>> for AttributeData {
    fn from(error: lalr1::Error<AATerminal>) -> Self {
        AttributeData::Error(error.clone())
    }
}

%}

%attr AttributeData
%target Command

%reduce_reduce 1

%%

%token  EOL     (\n)
%token  STRING  ("(\\"|[^"\t\r\n\v\f])+")
%token  ID      ([\w\d._\-/:]+)
%token  ASSIGN  "="
%token  UNSET   "unset"

%skip ([ \t]+)

%%

Command:
    ID "=" ID !{
        self.action = CommandAction::SetEnvVar($1.id(), $3.id());
    !}
    | ID "=" STRING !{
        self.action = CommandAction::SetEnvVar($1.id(), $3.string());
    !}
    | "unset" ID !{
        self.action = CommandAction::UnsetEnvVar($2.id());
    !}
    | ID !{
        self.action = CommandAction::RunProgram($1.id(), vec![], None, None, None);
    !}
    | ID Args !{
    !}
    .
Args: !{!}
    | Args Arg
    .
Arg: ID | STRING.
