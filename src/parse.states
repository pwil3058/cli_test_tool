Symbols:
  Tokens:
    AAEnd(): #(NonAssoc, 0)
    ASSIGN("="): #(NonAssoc, 0)
    EOL((\n)): #(NonAssoc, 0)
    ID(([\w\d._\-/:]+)): #(NonAssoc, 0)
    STRING(("(\\"|[^"\t\r\n\v\f])+")): #(NonAssoc, 0)
    UNSET("unset"): #(NonAssoc, 0)
  Non Terminal Symbols:
    AAStart: TokenSet{"unset", ID, STRING}:(false)
    Command: TokenSet{"unset", ID, STRING}:(false)

Productions:
  AAStart: Command #(NonAssoc, 0)
  Command: STRING ID #(NonAssoc, 0)
  Command: ID "=" ID #(NonAssoc, 0)
  Command: ID "=" STRING #(NonAssoc, 0)
  Command: "unset" ID #(NonAssoc, 0)

State<0>:
  Grammar Items:
    AAStart: . Command #(NonAssoc, 0): TokenSet{AAEnd}
    Command: . STRING ID #(NonAssoc, 0): TokenSet{AAEnd}
    Command: . ID "=" ID #(NonAssoc, 0): TokenSet{AAEnd}
    Command: . ID "=" STRING #(NonAssoc, 0): TokenSet{AAEnd}
    Command: . "unset" ID #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Shifts:
      "unset" -> State<4>
      ID -> State<3>
      STRING -> State<2>
  Go To Table:
    Command -> State<1>
  Error Recovery State: <none>

State<1>:
  Grammar Items:
    AAStart: Command .  #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Reductions:
      AAEnd: accept AAStart: Command #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<2>:
  Grammar Items:
    Command: STRING . ID #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Shifts:
      ID -> State<5>
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<3>:
  Grammar Items:
    Command: ID . "=" ID #(NonAssoc, 0): TokenSet{AAEnd}
    Command: ID . "=" STRING #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Shifts:
      "=" -> State<6>
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<4>:
  Grammar Items:
    Command: "unset" . ID #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Shifts:
      ID -> State<7>
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<5>:
  Grammar Items:
    Command: STRING ID .  #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Reductions:
      AAEnd: reduce Command: STRING ID #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<6>:
  Grammar Items:
    Command: ID "=" . ID #(NonAssoc, 0): TokenSet{AAEnd}
    Command: ID "=" . STRING #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Shifts:
      ID -> State<8>
      STRING -> State<9>
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<7>:
  Grammar Items:
    Command: "unset" ID .  #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Reductions:
      AAEnd: reduce Command: "unset" ID #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<8>:
  Grammar Items:
    Command: ID "=" ID .  #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Reductions:
      AAEnd: reduce Command: ID "=" ID #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<9>:
  Grammar Items:
    Command: ID "=" STRING .  #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Reductions:
      AAEnd: reduce Command: ID "=" STRING #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>
