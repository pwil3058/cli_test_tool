Symbols:
  Tokens:
    AAEnd(): #(NonAssoc, 0)
    ASSIGN("="): #(NonAssoc, 0)
    EOL((\n)): #(NonAssoc, 0)
    ID(([\w\d._\-/:]+)): #(NonAssoc, 0)
    STRING(("(\\"|[^"\t\r\n\v\f])+")): #(NonAssoc, 0)
    UNSET("unset"): #(NonAssoc, 0)
  Non Terminal Symbols:
    AAStart: TokenSet{"unset", ID}:(false)
    Arg: TokenSet{ID, STRING}:(false)
    Args: TokenSet{ID, STRING}:(true)
    Command: TokenSet{"unset", ID}:(false)

Productions:
  AAStart: Command #(NonAssoc, 0)
  Command: ID "=" ID #(NonAssoc, 0)
  Command: ID "=" STRING #(NonAssoc, 0)
  Command: "unset" ID #(NonAssoc, 0)
  Command: ID #(NonAssoc, 0)
  Command: ID Args #(NonAssoc, 0)
  Args: <empty> #(NonAssoc, 0)
  Args: Args Arg #(NonAssoc, 0)
  Arg: ID #(NonAssoc, 0)
  Arg: STRING #(NonAssoc, 0)

State<0>:
  Grammar Items:
    AAStart: . Command #(NonAssoc, 0): TokenSet{AAEnd}
    Command: . ID "=" ID #(NonAssoc, 0): TokenSet{AAEnd}
    Command: . ID "=" STRING #(NonAssoc, 0): TokenSet{AAEnd}
    Command: . "unset" ID #(NonAssoc, 0): TokenSet{AAEnd}
    Command: . ID #(NonAssoc, 0): TokenSet{AAEnd}
    Command: . ID Args #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Shifts:
      "unset" -> State<3>
      ID -> State<2>
  Go To Table:
    Command -> State<1>
  Error Recovery State: <none>

State<1>:
  Grammar Items:
    AAStart: Command .  #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Reductions:
      AAEnd: accept AAStart: Command #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<2>:
  Grammar Items:
    Command: ID . "=" ID #(NonAssoc, 0): TokenSet{AAEnd}
    Command: ID . "=" STRING #(NonAssoc, 0): TokenSet{AAEnd}
    Command: ID .  #(NonAssoc, 0): TokenSet{AAEnd}
    Command: ID . Args #(NonAssoc, 0): TokenSet{AAEnd}
    Args: . <empty> #(NonAssoc, 0): TokenSet{ID, STRING}
    Args: . Args Arg #(NonAssoc, 0): TokenSet{ID, STRING, AAEnd}
  Parser Action Table:
    Shifts:
      "=" -> State<4>
    Reductions:
      AAEnd: reduce Command: ID #(NonAssoc, 0)
      ID | STRING: reduce Args: <empty> #(NonAssoc, 0)
  Go To Table:
    Args -> State<5>
  Error Recovery State: <none>
  Reduce/Reduce Conflicts:
    TokenSet{AAEnd}
      reduce Command: ID .  #(NonAssoc, 0) : TokenSet{AAEnd}
      reduce Args: . <empty> #(NonAssoc, 0) : TokenSet{ID, STRING}

State<3>:
  Grammar Items:
    Command: "unset" . ID #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Shifts:
      ID -> State<6>
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<4>:
  Grammar Items:
    Command: ID "=" . ID #(NonAssoc, 0): TokenSet{AAEnd}
    Command: ID "=" . STRING #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Shifts:
      ID -> State<7>
      STRING -> State<8>
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<5>:
  Grammar Items:
    Command: ID Args .  #(NonAssoc, 0): TokenSet{AAEnd}
    Args: Args . Arg #(NonAssoc, 0): TokenSet{ID, STRING, AAEnd}
    Arg: . ID #(NonAssoc, 0): TokenSet{ID, STRING, AAEnd}
    Arg: . STRING #(NonAssoc, 0): TokenSet{ID, STRING, AAEnd}
  Parser Action Table:
    Shifts:
      ID -> State<10>
      STRING -> State<11>
    Reductions:
      AAEnd: reduce Command: ID Args #(NonAssoc, 0)
  Go To Table:
    Arg -> State<9>
  Error Recovery State: <none>

State<6>:
  Grammar Items:
    Command: "unset" ID .  #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Reductions:
      AAEnd: reduce Command: "unset" ID #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<7>:
  Grammar Items:
    Command: ID "=" ID .  #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Reductions:
      AAEnd: reduce Command: ID "=" ID #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<8>:
  Grammar Items:
    Command: ID "=" STRING .  #(NonAssoc, 0): TokenSet{AAEnd}
  Parser Action Table:
    Reductions:
      AAEnd: reduce Command: ID "=" STRING #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<9>:
  Grammar Items:
    Args: Args Arg .  #(NonAssoc, 0): TokenSet{ID, STRING, AAEnd}
  Parser Action Table:
    Reductions:
      ID | STRING | AAEnd: reduce Args: Args Arg #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<10>:
  Grammar Items:
    Arg: ID .  #(NonAssoc, 0): TokenSet{ID, STRING, AAEnd}
  Parser Action Table:
    Reductions:
      ID | STRING | AAEnd: reduce Arg: ID #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>

State<11>:
  Grammar Items:
    Arg: STRING .  #(NonAssoc, 0): TokenSet{ID, STRING, AAEnd}
  Parser Action Table:
    Reductions:
      ID | STRING | AAEnd: reduce Arg: STRING #(NonAssoc, 0)
  Go To Table:
    <empty>
  Error Recovery State: <none>
