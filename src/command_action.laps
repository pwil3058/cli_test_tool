%{
// Copyright 2026 (c) Peter Williams <pwil3058@bigpond.net.au> <pwil3058@gmail.com>
//
#[derive(Debug, Default, PartialEq, Eq)]
pub enum CommandAction {
    SetEnvVar(String, String),
    UnsetEnvVar(String),
    ChangeDir(String),
    RunProgram(String, Vec<String>, Option<String>, Option<(String, bool)>, Option<(String, bool)>),
    #[default]
    Default,
}

impl lalr1::ReportParseError<AATerminal> for CommandAction {}

#[derive(Debug, Default, Clone)]
pub enum AttributeData {
    String(String),
    Id(String),
    Args(Vec<String>),
    Input(Option<String>),
    Output(Option<(String, bool)>),
    Assign(String),
    #[default]
    Default
}

impl AttributeData {
    fn args(&self) -> Vec<String> {
        match self {
            Self::Args(args) => args.clone(),
            _ => panic!("Invalid AttributeData variant")
        }
    }

   fn args_mut(&mut self) -> &mut Vec<String> {
        match self {
            Self::Args(args) => args,
            _ => panic!("Invalid AttributeData variant")
        }
    }

    fn input(&self) -> Option<String> {
        match self {
            Self::Input(input) => input.clone(),
            _ => panic!("Invalid AttributeData variant")
        }
    }

    fn output(&self) -> Option<(String, bool)> {
        match self {
            Self::Output(output) => output.clone(),
            _ => panic!("Invalid AttributeData variant")
        }
    }

    fn string(&self) -> String {
        match self {
            Self::String(string) => string.clone(),
            _ => panic!("Invalid AttributeData variant")
        }
    }

    fn assign(&self) -> String {
        match self {
            Self::Assign(s) => s.clone(),
            _ => panic!("Invalid AttributeData variant: expected Assign")
        }
    }

    fn id(&self) -> String {
        match self {
            Self::Id(string) => string.clone(),
            _ => panic!("Invalid AttributeData variant")
        }
    }
}

impl From<lexan::Token<AATerminal>> for AttributeData {
    fn from(input: lexan::Token<AATerminal>) -> Self {
        match input.tag() {
            AATerminal::String => {
                let lexeme = input.lexeme();
                let clean_string = if lexeme.starts_with('"') && lexeme.ends_with('"') && lexeme.len() >= 2 {
                    lexeme[1..lexeme.len() - 1].to_string()
                } else {
                    lexeme.to_string()
                };
                 AttributeData::String(clean_string)
            },
            AATerminal::Assign => AttributeData::Assign(input.lexeme().to_string()),
            AATerminal::Id => AttributeData::Id(input.lexeme().to_string()),
            _ => AttributeData::Default
        }
    }
}

impl From<lalr1::SyntaxError<AATerminal>> for AttributeData {
    fn from(_error: lalr1::SyntaxError<AATerminal>) -> Self {
        AttributeData::Default
    }
}

%}

%attr AttributeData
%target CommandAction

%reduce_reduce 0

%%

%token  Eol         (\n)
%token  String      ("(\\"|[^"])+")
%token  Id          ([\w\d._\-/:]+)
%token  Assign      ([\w\d._\-/:]+=(([\w\d._\-/:]+)|("(\\"|[^"])+")))
%token  InputFile   "<"
%token  OverWrite   ">"
%token  Append      ">>"
%token  EOverWrite  "2>"
%token  EAppend     "2>>"
%token  Unset       "unset"
%token  ChangeDir   "cd"

%skip ([ \t]+)

%%

CommandAction:
    Assign Eol !{
        let string = $1.assign();
        let mut parts = string.split('=');
        let id = parts.next().unwrap().to_string();
        let value = parts.next().unwrap();
        let value = if value.starts_with('"') && value.ends_with('"') && value.len() >= 2 {
            value[1..value.len() - 1].to_string()
        } else {
            value.to_string()
        };
        *self = CommandAction::SetEnvVar(id, value);
    !}
    | "unset" Id Eol !{
        *self = CommandAction::UnsetEnvVar($2.id());
    !}
    | "cd" Id Eol !{
        *self = CommandAction::ChangeDir($2.id());
    !}
    | Id Args Input Output ErrOutput Eol !{
        *self = CommandAction::RunProgram(
            $1.id(),
            $2.args(),
            $3.input(),
            $4.output(),
            $5.output(),
        );
    !}
    .

Args: !{
        $$ = AttributeData::Args(vec![]);
    !}
    | Args Id !{
        $$.args_mut().push($2.id())
    !}
    | Args String !{
        $$.args_mut().push($2.string())
    !}
    | Args Assign !{
        $$.args_mut().push($2.assign())
    !}
    .

Input: !{ $$ = AttributeData::Input(None); !}
    | "<" Id !{ $$ = AttributeData::Input(Some($2.id())); !}
    .

Output: !{ $$ = AttributeData::Output(None); !}
    | ">" Id !{ $$ = AttributeData::Output(Some(($2.id(), true))); !}
    | ">>" Id !{ $$ = AttributeData::Output(Some(($2.id(), false))); !}
    .

ErrOutput: !{ $$ = AttributeData::Output(None); !}
    | "2>" Id !{ $$ = AttributeData::Output(Some(($2.id(), true))); !}
    | "2>>" Id !{ $$ = AttributeData::Output(Some(($2.id(), false))); !}
    .

