/target

Cargo.lock

# --- RustRover / JetBrains Specific ---
# Ignore all of .idea folder by default
.idea/*

# Allow sharing of specific configurations
!.idea/runConfigurations/
!.idea/codeStyles/
!.idea/scopes/
!.idea/vcs.xml
!.idea/copyright/

# Explicitly ignore user-specific or sensitive settings
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries
.idea/shelf/
.idea/dataSources/ls
.idea/dataSources.local.xml
.idea/sqlDataSources.xml
.idea/jsLibraryMappings.xml
.idea/httpRequests/
